<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                                   xmlns:app="http://schemas.android.com/apk/res-auto"
                                                   xmlns:tools="http://schemas.android.com/tools"
                                                   android:layout_width="match_parent"
                                                   android:layout_height="match_parent"
                                                   tools:context=".MainActivity">

    <!-- El mapa de Mapbox que ocupa toda la pantalla -->
    <com.mapbox.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    <!-- Título (esquina superior izquierda) -->
    <LinearLayout
            android:id="@+id/titlePanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_aero_glass"
                android:elevation="6dp"
                android:paddingStart="14dp"
                android:paddingEnd="18dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

            <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_aero_dot" />

            <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Geocorez"
                        android:textColor="@color/aero_deep"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                <TextView
                        android:id="@+id/modeTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ubicación por GPS"
                        android:textColor="@color/aero_text_soft"
                        android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Botones de control (esquina superior derecha) -->
    <LinearLayout
            android:id="@+id/controlsPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCenter"
                style="@style/Widget.AppCompat.Button"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="8dp"
                android:minWidth="130dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:background="@drawable/bg_aero_btn_blue"
                app:backgroundTint="@null"
                android:elevation="4dp"
                android:stateListAnimator="@null"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#99004A73"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="Centrar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMode"
                style="@style/Widget.AppCompat.Button"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="8dp"
                android:minWidth="130dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:background="@drawable/bg_aero_btn_aqua"
                app:backgroundTint="@null"
                android:elevation="4dp"
                android:stateListAnimator="@null"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#99004A73"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="Modo: GPS"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAddGeofence"
                style="@style/Widget.AppCompat.Button"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="8dp"
                android:minWidth="130dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:background="@drawable/bg_aero_btn_green"
                app:backgroundTint="@null"
                android:elevation="4dp"
                android:stateListAnimator="@null"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#99246B14"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="+ Círculo"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDraw"
                style="@style/Widget.AppCompat.Button"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="8dp"
                android:minWidth="130dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:background="@drawable/bg_aero_btn_green"
                app:backgroundTint="@null"
                android:elevation="4dp"
                android:stateListAnimator="@null"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#99246B14"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="Dibujar zona"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGeofences"
                style="@style/Widget.AppCompat.Button"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:minWidth="130dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:background="@drawable/bg_aero_btn_blue"
                app:backgroundTint="@null"
                android:elevation="4dp"
                android:stateListAnimator="@null"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#99004A73"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="Geocercas"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
    </LinearLayout>

    <!-- Panel de información (esquina inferior izquierda) -->
    <LinearLayout
            android:id="@+id/infoPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_aero_glass"
                android:elevation="6dp"
                android:paddingStart="16dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

            <TextView
                    android:id="@+id/latitudeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Latitud: 0.000000"
                    android:textColor="@color/aero_deep"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/longitudeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Longitud: 0.000000"
                    android:textColor="@color/aero_deep"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/aero_divider" />

            <TextView
                    android:id="@+id/geofenceStatusTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Geocercas: ninguna"
                    android:textColor="@color/aero_text_soft"
                    android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Panel de dibujo de zonas (esquina inferior derecha) -->
    <LinearLayout
            android:id="@+id/drawPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <TextView
                android:id="@+id/drawHintTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_aero_glass"
                android:elevation="6dp"
                android:maxWidth="150dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="Puntos: 0 (mínimo 3)"
                android:textColor="@color/aero_deep"
                android:textSize="13sp"
                android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDrawUndo"
                style="@style/Widget.AppCompat.Button"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="8dp"
                android:minWidth="130dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:background="@drawable/bg_aero_btn_blue"
                app:backgroundTint="@null"
                android:elevation="4dp"
                android:stateListAnimator="@null"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#99004A73"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="Deshacer"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDrawFinish"
                style="@style/Widget.AppCompat.Button"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="8dp"
                android:minWidth="130dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:background="@drawable/bg_aero_btn_green"
                app:backgroundTint="@null"
                android:elevation="4dp"
                android:stateListAnimator="@null"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#99246B14"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="Terminar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDrawCancel"
                style="@style/Widget.AppCompat.Button"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:minWidth="130dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:background="@drawable/bg_aero_btn_aqua"
                app:backgroundTint="@null"
                android:elevation="4dp"
                android:stateListAnimator="@null"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#99004A73"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
